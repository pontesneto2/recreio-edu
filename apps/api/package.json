{
  "name": "@recreio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./src/test/setup.ts --test \"src/**/*.test.ts\"",
    "openapi": "node src/scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/database/cli/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/database/cli/seed.ts",
    "db:reset": "node --env-file-if-exists=.env src/database/cli/reset.ts"
  },
  "dependencies": {
    "@recreio/contracts": "*",
    "@scalar/express-api-reference": "^0.10.43",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0"
  }
}
