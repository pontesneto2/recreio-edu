{
  "name": "@recreio/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env --import ./src/instrumentation.ts src/main.ts",
    "dev:worker": "node --watch --env-file-if-exists=.env --import ./src/instrumentation.ts src/worker.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node --env-file-if-exists=.env --import ./dist/instrumentation.js dist/main.js",
    "start:worker": "node --env-file-if-exists=.env --import ./dist/instrumentation.js dist/worker.js",
    "typecheck": "tsc -p tsconfig.json",
    "test": "node --import ./src/test/setup.ts --test \"src/**/*.test.ts\"",
    "openapi": "node src/scripts/generate-openapi.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env src/database/cli/migrate.ts",
    "db:seed": "node --env-file-if-exists=.env src/database/cli/seed.ts",
    "db:reset": "node --env-file-if-exists=.env src/database/cli/reset.ts",
    "email:teste": "node --env-file-if-exists=.env src/scripts/enviar-email-teste.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1178.0",
    "@aws-sdk/s3-request-presigner": "^3.1178.0",
    "@opentelemetry/api": "^1.10.0",
    "@opentelemetry/core": "^3.1.1",
    "@opentelemetry/instrumentation": "^0.301.2",
    "@opentelemetry/instrumentation-express": "^0.73.0",
    "@opentelemetry/instrumentation-http": "^0.301.2",
    "@opentelemetry/instrumentation-ioredis": "^0.73.0",
    "@opentelemetry/instrumentation-pg": "^0.78.0",
    "@opentelemetry/instrumentation-pino": "^0.71.0",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@recreio/contracts": "*",
    "@scalar/express-api-reference": "^0.10.43",
    "@sentry/node": "^11.20.0",
    "better-auth": "^1.7.28",
    "bullmq": "^6.7.10",
    "cors": "^2.8.6",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "import-in-the-middle": "^3.7.0",
    "ioredis": "^6.1.0",
    "nodemailer": "^10.6.1",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "rate-limit-redis": "^6.0.2",
    "zod": "^4.6.7",
    "zod-openapi": "^6.0.3"
  },
  "devDependencies": {
    "@testcontainers/postgresql": "^12.2.2",
    "@testcontainers/redis": "^12.2.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.4",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "testcontainers": "^12.2.2"
  }
}
