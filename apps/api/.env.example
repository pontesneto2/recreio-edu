NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300

# Banco (docker-compose.yml). A API conecta como recreio_app; migrações rodam como recreio.
DATABASE_URL=postgres://recreio_app:recreio_app@localhost:5432/recreio
DATABASE_MIGRATION_URL=postgres://recreio:recreio@localhost:5432/recreio

# Escola usada quando o portal roda em localhost (ADR 0006).
DEV_ESCOLA_DOMINIO=colegiorecreio.localhost

REDIS_URL=redis://localhost:6379

SMTP_URL=smtp://localhost:1025

S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=recreio
S3_SECRET_KEY=recreio-storage
S3_BUCKET=recreio
