NODE_ENV=development
PORT=3333
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
RATE_LIMIT_PER_MINUTE=300

# Banco (docker-compose.yml). A API conecta como recreio_app; migrações rodam como recreio.
DATABASE_URL=postgres://recreio_app:recreio_app@localhost:5432/recreio
DATABASE_MIGRATION_URL=postgres://recreio:recreio@localhost:5432/recreio

# Autenticação (ADR 0007). AUTH_SECRET é obrigatório em produção, com 32 caracteres ou mais.
# AUTH_SECRET=
AUTH_URL=http://localhost:5173
AUTH_TRUSTED_ORIGINS=http://localhost:5173
AUTH_RATE_LIMIT_PER_MINUTE=10

# Senha das contas de demonstração do db:seed. Só desenvolvimento: o seed não roda em produção.
SEED_SENHA_PADRAO=recreio-demo-2026

# Proxies confiáveis para o IP do cliente. Produção: número de saltos (veja docs/operacao/README.md).
TRUST_PROXY=loopback

# Filas BullMQ e contador do limite de requisições (ADR 0009).
REDIS_URL=redis://localhost:6379
WORKER_CONCURRENCY=5

# E-mail. O Mailpit mostra as mensagens em http://localhost:8025.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="Recreio <nao-responda@recreio.app>"

# Arquivos (ADR 0010). Em desenvolvimento a API cria o bucket ao subir.
S3_ENDPOINT=http://localhost:9000
# S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=recreio
S3_SECRET_KEY=recreio-storage
S3_BUCKET=recreio
S3_FORCE_PATH_STYLE=true
S3_URL_TTL_SECONDS=300

# Traces (OpenTelemetry). Jaeger local: docker compose --profile observabilidade up -d
OTEL_SDK_DISABLED=false
# Sem valor, a API vira recreio-api e o worker recreio-worker.
# OTEL_SERVICE_NAME=recreio-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# Erros no Sentry. Sem DSN, nada sai da máquina.
# SENTRY_DSN=https://chave@o0.ingest.sentry.io/0
# SENTRY_ENVIRONMENT=development
