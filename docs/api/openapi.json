{
  "openapi": "3.1.0",
  "info": {
    "title": "API Recreio",
    "version": "1.0.0",
    "description": "API do Recreio Sistema Educacional. Erros seguem a RFC 9457 (`application/problem+json`) com o campo `code`. Toda resposta traz `X-Request-Id`. Rotas com cadeado exigem o cookie de sessão do Better Auth, obtido em `POST /api/auth/sign-in/email`."
  },
  "servers": [
    {
      "url": "/api/v1"
    }
  ],
  "tags": [
    {
      "name": "Sessão",
      "description": "Quem está logado. Entrar, sair e trocar senha ficam em `/api/auth/*`, rotas do Better Auth fora deste documento."
    },
    {
      "name": "Escola",
      "description": "Dados da escola e das unidades."
    },
    {
      "name": "Alunos",
      "description": "Alunos matriculados na escola. Exige a permissão `alunos:ver`."
    }
  ],
  "paths": {
    "/eu": {
      "get": {
        "operationId": "obterEu",
        "summary": "Obtém a pessoa logada e os vínculos dela em cada escola",
        "tags": [
          "Sessão"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "responses": {
          "200": {
            "description": "A pessoa e as escolas em que tem vínculo, com os perfis em cada uma. Lista vazia sem vínculo.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Eu"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      }
    },
    "/escolas/{escola}": {
      "get": {
        "operationId": "obterEscola",
        "summary": "Obtém os dados da escola",
        "description": "Exige a permissão `painel:ver`.",
        "tags": [
          "Escola"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "escola",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Slug da escola, como `colegio-recreio`."
            },
            "required": true,
            "description": "Slug da escola, como `colegio-recreio`."
          }
        ],
        "responses": {
          "200": {
            "description": "Dados da escola, com as unidades.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Escola"
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/AcessoNegado"
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      }
    },
    "/escolas/{escola}/publica": {
      "get": {
        "operationId": "obterEscolaPublica",
        "summary": "Obtém nome, cidade e cor da escola, sem login",
        "description": "Aberta, porque a tela de entrada mostra a escola antes do login.",
        "tags": [
          "Escola"
        ],
        "security": [],
        "parameters": [
          {
            "in": "path",
            "name": "escola",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Slug da escola, como `colegio-recreio`."
            },
            "required": true,
            "description": "Slug da escola, como `colegio-recreio`."
          }
        ],
        "responses": {
          "200": {
            "description": "Dados públicos da escola do slug.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EscolaPublica"
                }
              }
            }
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      }
    },
    "/escolas/{escola}/alunos": {
      "get": {
        "operationId": "listarAlunos",
        "summary": "Lista os alunos",
        "tags": [
          "Alunos"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "escola",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Slug da escola, como `colegio-recreio`."
            },
            "required": true,
            "description": "Slug da escola, como `colegio-recreio`."
          }
        ],
        "responses": {
          "200": {
            "description": "Todos os alunos da escola.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Aluno"
                  }
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/AcessoNegado"
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      }
    },
    "/escolas/{escola}/alunos/{id}": {
      "get": {
        "operationId": "buscarAluno",
        "summary": "Busca um aluno pelo id",
        "tags": [
          "Alunos"
        ],
        "security": [
          {
            "cookieAuth": []
          }
        ],
        "parameters": [
          {
            "in": "path",
            "name": "escola",
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 63,
              "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
              "description": "Slug da escola, como `colegio-recreio`."
            },
            "required": true,
            "description": "Slug da escola, como `colegio-recreio`."
          },
          {
            "in": "path",
            "name": "id",
            "schema": {
              "type": "string",
              "format": "uuid",
              "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$",
              "description": "Identificador do aluno."
            },
            "required": true,
            "description": "Identificador do aluno."
          }
        ],
        "responses": {
          "200": {
            "description": "O aluno.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Aluno"
                }
              }
            }
          },
          "400": {
            "$ref": "#/components/responses/DadosInvalidos"
          },
          "401": {
            "$ref": "#/components/responses/NaoAutenticado"
          },
          "403": {
            "$ref": "#/components/responses/AcessoNegado"
          },
          "404": {
            "$ref": "#/components/responses/NaoEncontrado"
          },
          "429": {
            "$ref": "#/components/responses/LimiteExcedido"
          },
          "500": {
            "$ref": "#/components/responses/ErroInterno"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Problema": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "format": "uri",
            "description": "URL que identifica o tipo de erro."
          },
          "title": {
            "type": "string",
            "description": "Resumo do tipo de erro. Igual para todo erro do mesmo tipo."
          },
          "status": {
            "type": "integer",
            "minimum": 400,
            "maximum": 599,
            "description": "Status HTTP da resposta."
          },
          "detail": {
            "description": "Explicação deste erro em particular.",
            "type": "string"
          },
          "instance": {
            "description": "Caminho da requisição que falhou, sem a query.",
            "type": "string"
          },
          "code": {
            "type": "string",
            "description": "Código estável do erro, como `NAO_ENCONTRADO`."
          },
          "errors": {
            "type": "object",
            "propertyNames": {
              "type": "string"
            },
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "description": "Mensagens por campo quando `code` é `DADOS_INVALIDOS`. A chave `$` marca erro fora de campo."
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "code"
        ],
        "additionalProperties": false
      },
      "Eu": {
        "type": "object",
        "properties": {
          "usuario": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "nome": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email",
                "pattern": "^(?:[A-Za-z0-9_'+\\-]+\\.)*[A-Za-z0-9_'+\\-]*[A-Za-z0-9_+-]@(?:[A-Za-z0-9][A-Za-z0-9\\-]*\\.)+[A-Za-z]{2,}$"
              },
              "emailVerificado": {
                "type": "boolean"
              }
            },
            "required": [
              "id",
              "nome",
              "email",
              "emailVerificado"
            ],
            "additionalProperties": false
          },
          "escolas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "slug": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 63,
                  "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
                },
                "nome": {
                  "type": "string"
                },
                "perfis": {
                  "minItems": 1,
                  "type": "array",
                  "items": {
                    "type": "string",
                    "enum": [
                      "responsavel",
                      "aluno",
                      "professor",
                      "secretaria",
                      "financeiro",
                      "portaria",
                      "coordenacao",
                      "direcao"
                    ]
                  }
                }
              },
              "required": [
                "slug",
                "nome",
                "perfis"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "usuario",
          "escolas"
        ],
        "additionalProperties": false
      },
      "Escola": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string"
          },
          "cnpj": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "corMarca": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "hoje": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "unidades": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "format": "uuid",
                  "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
                },
                "nome": {
                  "type": "string"
                },
                "alunos": {
                  "type": "integer",
                  "minimum": 0,
                  "maximum": 9007199254740991
                }
              },
              "required": [
                "id",
                "nome",
                "alunos"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "nome",
          "cnpj",
          "cidade",
          "corMarca",
          "hoje",
          "unidades"
        ],
        "additionalProperties": false
      },
      "EscolaPublica": {
        "type": "object",
        "properties": {
          "slug": {
            "type": "string",
            "minLength": 1,
            "maxLength": 63,
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "nome": {
            "type": "string"
          },
          "cidade": {
            "type": "string"
          },
          "corMarca": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          }
        },
        "required": [
          "slug",
          "nome",
          "cidade",
          "corMarca"
        ],
        "additionalProperties": false
      },
      "Aluno": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
          },
          "nome": {
            "type": "string"
          },
          "turma": {
            "type": "string"
          },
          "turno": {
            "type": "string"
          },
          "matricula": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{4}$"
          },
          "mensalidadeCentavos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "nome",
          "turma",
          "turno",
          "matricula",
          "mensalidadeCentavos"
        ],
        "additionalProperties": false
      }
    },
    "responses": {
      "NaoAutenticado": {
        "description": "A requisição não trouxe o cookie de sessão, ou a sessão expirou. Entre de novo.",
        "content": {
          "application/problem+json": {
            "example": {
              "type": "https://recreio.app/problemas/nao-autenticado",
              "title": "Sessão ausente ou expirada",
              "status": 401,
              "detail": "Sessão ausente ou expirada. Entre de novo para continuar.",
              "instance": "/api/v1/eu",
              "code": "NAO_AUTENTICADO"
            },
            "schema": {
              "$ref": "#/components/schemas/Problema"
            }
          }
        }
      },
      "NaoEncontrado": {
        "description": "O recurso não existe, ou o slug da rota não pertence a nenhuma escola.",
        "content": {
          "application/problem+json": {
            "example": {
              "type": "https://recreio.app/problemas/nao-encontrado",
              "title": "Recurso não encontrado",
              "status": 404,
              "detail": "Aluno não encontrado.",
              "instance": "/api/v1/escolas/colegio-recreio/alunos/7a1e2b3c-0000-4000-8000-000000000000",
              "code": "NAO_ENCONTRADO"
            },
            "schema": {
              "$ref": "#/components/schemas/Problema"
            }
          }
        }
      },
      "LimiteExcedido": {
        "description": "O cliente passou do limite de requisições por minuto.",
        "headers": {
          "Retry-After": {
            "required": true,
            "description": "Segundos até a janela do limite reiniciar.",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991,
              "description": "Segundos até a janela do limite reiniciar."
            }
          },
          "RateLimit": {
            "required": true,
            "description": "Requisições restantes e segundos até reiniciar (draft 8 da IETF).",
            "schema": {
              "type": "string",
              "description": "Requisições restantes e segundos até reiniciar (draft 8 da IETF)."
            }
          },
          "RateLimit-Policy": {
            "required": true,
            "description": "Cota e janela do limite (draft 8 da IETF).",
            "schema": {
              "type": "string",
              "description": "Cota e janela do limite (draft 8 da IETF)."
            }
          }
        },
        "content": {
          "application/problem+json": {
            "example": {
              "type": "https://recreio.app/problemas/limite-excedido",
              "title": "Limite de requisições excedido",
              "status": 429,
              "detail": "Limite de 300 requisições por minuto excedido. Tente de novo após o tempo de Retry-After.",
              "instance": "/api/v1/escolas/colegio-recreio/alunos",
              "code": "LIMITE_EXCEDIDO"
            },
            "schema": {
              "$ref": "#/components/schemas/Problema"
            }
          }
        }
      },
      "ErroInterno": {
        "description": "Erro não previsto. O detalhe fica só no log, ligado ao X-Request-Id.",
        "content": {
          "application/problem+json": {
            "example": {
              "type": "https://recreio.app/problemas/erro-interno",
              "title": "Erro interno",
              "status": 500,
              "detail": "Erro interno. Tente de novo em instantes.",
              "instance": "/api/v1/escolas/colegio-recreio/alunos",
              "code": "ERRO_INTERNO"
            },
            "schema": {
              "$ref": "#/components/schemas/Problema"
            }
          }
        }
      },
      "AcessoNegado": {
        "description": "A conta não tem vínculo com a escola (`SEM_ACESSO`) ou não tem a permissão (`PERMISSAO_NEGADA`).",
        "content": {
          "application/problem+json": {
            "schema": {
              "$ref": "#/components/schemas/Problema"
            },
            "examples": {
              "SEM_ACESSO": {
                "value": {
                  "type": "https://recreio.app/problemas/sem-acesso",
                  "title": "Sem acesso a esta escola",
                  "status": 403,
                  "detail": "A conta não tem vínculo com esta escola.",
                  "instance": "/api/v1/escolas/colegio-recreio/alunos",
                  "code": "SEM_ACESSO"
                }
              },
              "PERMISSAO_NEGADA": {
                "value": {
                  "type": "https://recreio.app/problemas/permissao-negada",
                  "title": "Permissão negada",
                  "status": 403,
                  "detail": "Os perfis da conta não têm a ação \"ver\" no módulo \"alunos\".",
                  "instance": "/api/v1/escolas/colegio-recreio/alunos",
                  "code": "PERMISSAO_NEGADA"
                }
              }
            }
          }
        }
      },
      "DadosInvalidos": {
        "description": "A entrada não segue o schema do contrato.",
        "content": {
          "application/problem+json": {
            "example": {
              "type": "https://recreio.app/problemas/dados-invalidos",
              "title": "Dados inválidos",
              "status": 400,
              "detail": "Os dados enviados não são válidos.",
              "instance": "/api/v1/escolas/colegio-recreio/alunos/ID%20Inv%C3%A1lido",
              "code": "DADOS_INVALIDOS",
              "errors": {
                "id": [
                  "Formato do UUID inválido"
                ]
              }
            },
            "schema": {
              "$ref": "#/components/schemas/Problema"
            }
          }
        }
      }
    },
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "recreio.session_token",
        "description": "Cookie httpOnly do Better Auth. Em produção o nome ganha o prefixo `__Secure-`. O portal envia com `credentials: \"include\"`."
      }
    }
  }
}
